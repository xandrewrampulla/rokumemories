<?xml version="1.0" encoding="utf-8"?>
<component name="ScreensaverScene" extends="Scene">
    <script type="text/brightscript" uri="ScreensaverScene.brs" />

    <children>

        <Poster id="image1"
            width="1280"
            height="720"
            loadDisplayMode="noScale"
            opacity="1.0" />

        <Poster id="image2"
            width="1280"
            height="720"
            loadDisplayMode="noScale"
            opacity="0.0" />

        <Timer id="mytimer" repeat="true" duration="15"/>

    </children>
</component>
