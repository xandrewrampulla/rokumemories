<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="configuration" type="assocarray" onChange="configurationChanged" />
        <field id="settingsOnly" type="boolean" value="false" />
        <field id="saveRequested" type="assocarray" alwaysNotify="true" />
        <field id="saveResult" type="assocarray" onChange="settingsSaved" alwaysNotify="true" />
        <field id="exitRequested" type="boolean" value="false" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/Configuration.brs" />
    <script type="text/brightscript" uri="pkg:/components/Slideshow.brs" />
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <children>
        <Rectangle width="1280" height="720" color="0x000000FF" />
        <Poster id="posterA" width="1280" height="720" loadWidth="1280"
                loadHeight="720" loadDisplayMode="scaleToFit" opacity="0" />
        <Poster id="posterB" width="1280" height="720" loadWidth="1280"
                loadHeight="720" loadDisplayMode="scaleToFit" opacity="0" />
        <BusySpinner id="spinner" translation="[610,330]" visible="false" />
        <Label id="status" translation="[160,260]" width="960" height="200"
               horizAlign="center" vertAlign="center" wrap="true" />
        <Timer id="slideTimer" repeat="false" duration="15" />
        <Timer id="loadTimeout" repeat="false" duration="30" />
        <Group id="settings" visible="false">
            <Rectangle width="1280" height="720" color="0x000000C0" />
            <Rectangle translation="[100,60]" width="1080" height="600" color="0x202020FF" />
            <Label translation="[140,90]" text="Roku Memories Settings" font="font:LargeBoldSystemFont" />
            <Label translation="[140,170]" text="Server:" />
            <Label id="serverValue" translation="[280,170]" width="840" height="40" />
            <Label translation="[140,220]" text="Delay:" />
            <Label id="delayValue" translation="[280,220]" width="840" height="40" />
            <LabelList id="settingsMenu" translation="[140,290]" itemSize="[960,56]"
                       numRows="4" vertFocusAnimationStyle="floatingFocus">
                <ContentNode role="content">
                    <ContentNode title="Edit server URL" />
                    <ContentNode title="Edit delay" />
                    <ContentNode title="Save" />
                    <ContentNode title="Cancel" />
                </ContentNode>
            </LabelList>
            <Label id="settingsStatus" translation="[140,540]" width="960" height="90" wrap="true" />
        </Group>
    </children>
</component>
